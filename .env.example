# ── LLM open-source (priorité recommandée pour la démo) ──────────────────────
# Groq : clé gratuite sur https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral AI : clé gratuite sur https://console.mistral.ai → API Keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ── LLM alternatifs (optionnels) ─────────────────────────────────────────────
# OpenAI (payant, utilisé si aucun LLM gratuit configuré)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama local (gratuit, nécessite Ollama installé + `ollama pull mistral`)
ENABLE_OLLAMA_FALLBACK=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=mistral:latest

# ── Données de marché (optionnelles, yfinance est toujours actif gratuitement) ─
# NewsAPI : clé gratuite (100 req/jour) sur https://newsapi.org → Register
NEWSAPI_KEY=

# Alpha Vantage : clé gratuite (25 req/jour) sur https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# ── Paramètres divers ─────────────────────────────────────────────────────────
NEWS_ARTICLES_LIMIT=5
